APP_ENV=development
APP_NAME=Intelligent SWIFT Message Engineering Platform
DATABASE_URL=sqlite:///./data/securities_studio.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=6291456
MAX_BULK_ROWS=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=600
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_PROVIDER=openrouter
AI_MODE=required
# Server-side secret. Keep empty in this example and never expose it to the browser.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=openai/gpt-5.4-mini
OPENROUTER_ESCALATION_MODEL=openai/gpt-5.4
OPENROUTER_ESCALATION_ENABLED=true
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Intelligent SWIFT Message Engineering Platform
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR_REQUIRED=true
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_OPERATION_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_INPUT_CHARS=6000
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_CONFIDENCE_THRESHOLD=0.80
OPENROUTER_DAILY_REQUEST_BUDGET=
OPENROUTER_DAILY_TOKEN_BUDGET=
OPENROUTER_LOG_CONTENT=false
OPENROUTER_RETRY_BASE_SECONDS=0.25
OPENROUTER_RETRY_MAX_SECONDS=3
OPENROUTER_CIRCUIT_FAILURE_THRESHOLD=5
OPENROUTER_CIRCUIT_COOLDOWN_SECONDS=30
AI_CACHE_ENABLED=true
# Server-side HMAC secret (minimum 32 characters). Keep empty in this example.
AI_CACHE_HMAC_SECRET=
AI_CACHE_KEY_VERSION=v1
AI_CACHE_INTENT_TTL_SECONDS=2592000
AI_CACHE_EXPLANATION_TTL_SECONDS=7776000
AI_CACHE_VALIDATION_TTL_SECONDS=2592000
AI_CACHE_L1_MAX_ENTRIES=256
AI_CACHE_STAMPEDE_WAIT_SECONDS=45
AI_CACHE_KNOWLEDGE_VERSION=KB_2026_08_05_V2
AI_CACHE_TAXONOMY_VERSION=WORKFLOW_TAXONOMY_V1
AI_CACHE_ADMIN_ENABLED=false
DEMO_RESET_ENABLED=true
DEMO_RESET_KEY=
REAL_DATA_MODE_ENABLED=false
AUTH_MODE=development
SESSION_COOKIE_NAME=swift_platform_session
SESSION_TTL_SECONDS=28800
SESSION_SECURE_COOKIES=false
# Server-side HMAC secret, minimum 32 characters. Keep empty in this example.
SESSION_HMAC_SECRET=
CSRF_COOKIE_NAME=swift_platform_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Base64-encoded 32-byte wrapping key. Load from a server-side secret manager.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=local-v1
DATA_RETENTION_DAYS=90
SUBMISSION_MODE=disabled
PRODUCTION_SUBMISSION_ENABLED=false
MOCK_UAT_CONNECTOR_ENABLED=false
EXTERNAL_VALIDATION_REQUIRED_FOR_SUBMISSION=true
FIN_EXPORT_ENABLED=true
# Enable only after an authorised client RJE contract is configured.
RJE_EXPORT_ENABLED=false
