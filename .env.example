APP_ENV=development
APP_NAME=Intelligent SWIFT Message Engineering Platform
DATABASE_URL=sqlite:///./data/securities_studio.db
# Comma-separated. Both spellings of the same machine, so a tester who opens one of
# them is not refused by CORS for not choosing the other.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# An address, not `localhost`: a browser resolves `localhost` to ::1 first on a dual-stack
# machine, and the backend binds 127.0.0.1, so the occasional request dies with
# ECONNREFUSED and reads to the tester as "the backend is down".
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=6291456
MAX_BULK_ROWS=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=600
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_PROVIDER=disabled
AI_MODE=optional
# Server-side secret. Keep empty in this example and never expose it to the browser.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=openai/gpt-5.4-mini
OPENROUTER_ESCALATION_MODEL=openai/gpt-5.4
OPENROUTER_ESCALATION_ENABLED=true
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Intelligent SWIFT Message Engineering Platform
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR_REQUIRED=true
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_OPERATION_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_INPUT_CHARS=6000
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_CONFIDENCE_THRESHOLD=0.80
OPENROUTER_DAILY_REQUEST_BUDGET=
OPENROUTER_DAILY_TOKEN_BUDGET=
OPENROUTER_LOG_CONTENT=false
OPENROUTER_RETRY_BASE_SECONDS=0.25
OPENROUTER_RETRY_MAX_SECONDS=3
OPENROUTER_CIRCUIT_FAILURE_THRESHOLD=5
OPENROUTER_CIRCUIT_COOLDOWN_SECONDS=30
AI_CACHE_ENABLED=true
# Server-side HMAC secret (minimum 32 characters). Keep empty in this example.
AI_CACHE_HMAC_SECRET=
AI_CACHE_KEY_VERSION=v1
AI_CACHE_INTENT_TTL_SECONDS=2592000
AI_CACHE_EXPLANATION_TTL_SECONDS=7776000
AI_CACHE_VALIDATION_TTL_SECONDS=2592000
AI_CACHE_L1_MAX_ENTRIES=256
AI_CACHE_STAMPEDE_WAIT_SECONDS=45
AI_CACHE_KNOWLEDGE_VERSION=KB_2026_08_05_V2
AI_CACHE_TAXONOMY_VERSION=WORKFLOW_TAXONOMY_V1
AI_CACHE_ADMIN_ENABLED=false
DEMO_RESET_ENABLED=true
DEMO_RESET_KEY=
REAL_DATA_MODE_ENABLED=false
AUTH_MODE=development
SESSION_COOKIE_NAME=swift_platform_session
SESSION_TTL_SECONDS=28800
SESSION_SECURE_COOKIES=false
# Server-side HMAC secret, minimum 32 characters. Keep empty in this example.
SESSION_HMAC_SECRET=
CSRF_COOKIE_NAME=swift_platform_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Base64-encoded 32-byte wrapping key. Load from a server-side secret manager.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=local-v1
DATA_RETENTION_DAYS=90
SUBMISSION_MODE=disabled
PRODUCTION_SUBMISSION_ENABLED=false
MOCK_UAT_CONNECTOR_ENABLED=false
EXTERNAL_VALIDATION_REQUIRED_FOR_SUBMISSION=true
FIN_EXPORT_ENABLED=true
# Enable only after an authorised client RJE contract is configured.
RJE_EXPORT_ENABLED=false

# --- Automation API -------------------------------------------------------------------
# Comma-separated service keys for /api/v1. Leave empty for local development, where the
# automation API is open. Outside development the API is closed until keys are set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEYS=
MAX_EXCEL_SCENARIOS=200

# --- Authoritative sources ---------------------------------------------------------------
# Where licensed specification artifacts are read from. Leave empty to use the configuration
# committed to this repository, which is what makes a clean clone work with no environment.
# Nothing licensed is committed here; see docs/authoritative-sources.md for the procedure.
MT_SPECIFICATION_MANIFEST=
MX_SPECIFICATION_DIRECTORY=
MX_OFFICIAL_XSD_DIRECTORY=
CLIENT_PROFILE_DIRECTORY=

# --- Phase 6: organisation AI endpoint (Azure OpenAI or any OpenAI-compatible server) -------
# Names only; never commit values. The endpoint's origin is used; the path/query is ignored
# except that an api-version query is kept for the legacy deployment-scoped Azure surface.
# Legacy spellings ENDPOINT / API_KEY / MODEL are honoured as aliases of the first three.
AI_ENDPOINT=
AI_API_KEY=
AI_CHAT_DEPLOYMENT=
AI_API_VERSION=
AI_MAX_OUTPUT_TOKENS=2000
# Embedding deployment for the knowledge base. EMBEDDING_PROVIDER: auto | azure_openai |
# openai_compatible | fake | disabled. `fake` is for tests and CI only.
EMBEDDINGS_DEPLOYMENT=
EMBEDDING_PROVIDER=disabled
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# --- Phase 6: local knowledge base (RAG + dynamic structure packs) --------------------------
# KNOWLEDGE_MODE: disabled | local | local_uat. `local_uat` also enables POST /knowledge/sync.
# Sources stay in the operator's folder; the index, vectors, source cache and compiled packs
# land under ignored build/knowledge/. Nothing licensed is committed.
# Set it HERE, not only on a Make target: the knowledge-* targets export `local` for their own
# process, but `make backend` / `make dev` do not, so a server left on the default reports
# "not indexed" and drops the preview lane from the catalogue however complete the index is.
KNOWLEDGE_MODE=disabled
# Comma-separated roots, relative to the project root. Discovery recurses, so one root over a
# foldered drop (swiftKnowledgeBase/MT, swiftKnowledgeBase/MX, …) beats a list that has to be
# edited whenever a folder appears. Sources are keyed by content hash, so reorganising the
# folders keeps every index entry and vector. Anything outside the roots of the current run is
# tombstoned, so keep all intended roots in the same value.
KNOWLEDGE_SOURCE_DIR=swiftKnowledgeBase
KNOWLEDGE_DB_PATH=build/knowledge/knowledge.sqlite3
KNOWLEDGE_PACK_DIR=build/knowledge/packs
KNOWLEDGE_SOURCE_CACHE_DIR=build/knowledge/source-cache
KNOWLEDGE_AUTO_SYNC_ON_START=false
# Licensed text leaves the machine only when BOTH the global gate and the classification
# list say so. An API key is never permission. Default: only synthetic fixtures.
# Resolved once per source at parse time and stored on its row, so widening either gate takes
# effect on `make knowledge-reindex` — an incremental sync skips unchanged sources untouched.
KNOWLEDGE_EXTERNAL_EMBEDDING_ALLOWED=false
KNOWLEDGE_EXTERNAL_LLM_ALLOWED=false
KNOWLEDGE_EXTERNAL_PROCESSING_CLASSIFICATIONS=SYNTHETIC_FIXTURE
KNOWLEDGE_MAX_SOURCE_BYTES=67108864
KNOWLEDGE_MAX_ZIP_MEMBER_BYTES=67108864
KNOWLEDGE_MAX_ZIP_TOTAL_BYTES=268435456
KNOWLEDGE_CONTEXT_CHARS=6000
KNOWLEDGE_AI_MAX_BATCH=20
KNOWLEDGE_AI_MAX_REPAIR_ATTEMPTS=3
KNOWLEDGE_AI_REVIEWER_MODE=false
# auto | scripted | disabled. `scripted` (deterministic seed, no network) is honoured in
# development and test only.
KNOWLEDGE_AI_PROVIDER=disabled
KNOWLEDGE_TELEMETRY_RETENTION_DAYS=30
KNOWLEDGE_TELEMETRY_RECENT_LIMIT=50

# Optional secure bootstrap for organisation-approved source bundles. Set exactly one URL
# or local path and the required SHA-256 checksum; credentials belong in a presigned URL or
# organisation connector, never in this file.
KNOWLEDGE_BUNDLE_URL=
KNOWLEDGE_BUNDLE_PATH=
KNOWLEDGE_BUNDLE_SHA256=
