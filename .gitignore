.DS_Store
**/.DS_Store

# Licensed ISO 20022 schemas are dropped in locally, never committed.
backend/config/mx/xsd/official/*.xsd

# Phase 3 ISO 20022 source bundles and downloads are local/operator-owned. Metadata such
# as README files and reviewed manifests may be tracked; raw source bodies are not.
backend/config/mx/xsd/sources/*
!backend/config/mx/xsd/sources/README.md
!backend/config/mx/xsd/sources/*.yaml

# The autonomous engagement brief. Kept locally, never committed.
workPrompt.txt

# Business-rule source documents are dropped in locally, never committed. Only the
# synthetic fixtures this repository owns are tracked.
backend/config/rule_sources/*
!backend/config/rule_sources/README.md
!backend/config/rule_sources/sources.yaml
!backend/config/rule_sources/synthetic-*.md
