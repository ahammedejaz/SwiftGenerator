.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/.venv/
backend/data/
frontend/node_modules/
frontend/.next/
frontend/.next-*/
frontend/playwright-report/
frontend/test-results/
frontend/data/
*.tsbuildinfo
*.log
backend/.mypy_cache/
backend/.ruff_cache/
backend/data/
data/
.DS_Store
**/.DS_Store

# Licensed ISO 20022 schemas are dropped in locally, never committed.
backend/config/mx/xsd/official/*.xsd

# Phase 3 ISO 20022 source bundles and downloads are local/operator-owned. Metadata such
# as README files and reviewed manifests may be tracked; raw source bodies are not.
backend/config/mx/xsd/sources/*
!backend/config/mx/xsd/sources/README.md
!backend/config/mx/xsd/sources/*.yaml
build/mx-real-sources/
build/mx-real-candidates/
build/mt-prowide-cache/
build/mt-prowide-candidates/
build/mt-prowide-inspect/
build/mt-mrg/

# The autonomous engagement brief. Kept locally, never committed.
workPrompt.txt

# Business-rule source documents are dropped in locally, never committed. Only the
# synthetic fixtures this repository owns are tracked.
backend/config/rule_sources/*
!backend/config/rule_sources/README.md
!backend/config/rule_sources/sources.yaml
!backend/config/rule_sources/mt-mrg-sources.yaml
!backend/config/rule_sources/synthetic-*.md

# The authorised knowledge base (swiftKnowledgeBase/) is committed for this internal
# project — source PDFs and XSDs through Git LFS (see .gitattributes) with their manifest.
# What is never committed is anything derived from it or anything personal: the operator's
# own notes, browser state or scratch files dropped beside the sources.
/swiftKnowledgeBase/**/.DS_Store
/swiftKnowledgeBase/**/*.tmp
/swiftKnowledgeBase/**/~$*
/swiftKnowledgeBase/**/.~lock.*

# Phase 6 Knowledge Base: the SQLite index (segments, embedding vectors, sample cache),
# extracted source cache and compiled dynamic packs are derived from licensed sources and
# live outside Git. Only docs/generated reports (counts, hashes, no source text) are tracked.
build/knowledge/
build/knowledge-e2e/
build/knowledge-*/
